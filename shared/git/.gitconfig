[user]
	name = fredrir
	email = fhansteen@gmail.com
	signingkey = ~/.ssh/id_ed25519.pub

[fetch]
	prune = true

[rerere]
	enabled = true

[core]
	editor = nvim
	pager = delta
	fsync = committed
	fsyncMethod = batch
[init]
	defaultBranch = main
[gpg]
	format = ssh
[commit]
	gpgsign = true
[tag]
	gpgSign = true
[interactive]
	diffFilter = delta --color-only
[delta]
	features = unified
	navigate = true
	light = false
	line-numbers = true
	syntax-theme = Fredrir
	max-line-distance = 0.8
	minus-style = syntax "#7a2936"
	minus-emph-style = syntax "#b3596b"
	plus-style = syntax "#225c2b"
	plus-emph-style = syntax "#38a660"
	line-numbers-minus-style = "#dc5a5a"
	line-numbers-plus-style = "#50c850"
	hunk-header-style = file line-number syntax
[delta "unified"]
	line-numbers-left-format = ""
[delta "split"]
	side-by-side = true
	line-numbers-left-format = "{nm:^4}│"
	wrap-max-lines = unlimited

[merge]
	conflictStyle = zdiff3
[diff]
	colorMoved = default
[push]
	autoSetupRemote = true