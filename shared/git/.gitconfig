[user]
	name = fredrir
	email = fhansteen@gmail.com
	signingkey = ~/.ssh/id_ed25519.pub

[fetch]
	prune = true

[rerere]
	enabled = true

[core]
	editor = nvim
	pager = delta
	fsync = committed
	fsyncMethod = batch
[init]
	defaultBranch = main
[gpg]
	format = ssh
[commit]
	gpgsign = true
[tag]
	gpgSign = true
[interactive]
	diffFilter = delta --color-only
[delta]
	features = unified
	navigate = true
	light = false
	line-numbers = true
	syntax-theme = 2026 Dark
	max-line-distance = 0.8
	minus-style = syntax "#2d1919"
	minus-emph-style = syntax "#693331"
	plus-style = syntax "#17231a"
	plus-emph-style = syntax "#2a4c2d"
	line-numbers-minus-style = "#f28772"
	line-numbers-plus-style = "#72c892"
	line-numbers-zero-style = "#858889"
	line-numbers-left-style = "#343536"
	line-numbers-right-style = "#343536"
	file-added-label = ""
	file-modified-label = "Modified:"
	file-removed-label = "Deleted:"
	file-renamed-label = "Renamed:"
	file-decoration-style = "#2a2b2c ul"
	hunk-header-style = omit
[delta "unified"]
	line-numbers-left-format = ""
	file-style = "#bfbfbf"
[delta "split"]
	side-by-side = true
	line-numbers-left-format = "{nm:^4}│"
	wrap-max-lines = unlimited
[delta "added"]
	file-style = "#73c991"
[delta "modified"]
	file-style = "#e5ba7d"
[delta "deleted"]
	file-style = "#f48771"

[merge]
	conflictStyle = zdiff3
[diff]
	colorMoved = default
[push]
	autoSetupRemote = true