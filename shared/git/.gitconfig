[user]
	name = fredrir
	email = fhansteen@gmail.com
	signingkey = ~/.ssh/id_ed25519.pub

[fetch]
	prune = true

[rerere]
	enabled = true
	
[core]
	editor = nvim
	pager = delta
	fsync = committed
	fsyncMethod = batch
[init]
	defaultBranch = main
[gpg]
	format = ssh
[commit]
	gpgsign = true
[tag]
	gpgSign = true
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
	line-numbers = true
	light = false
[merge]
	conflictStyle = zdiff3
[diff]
	colorMoved = default
[push]
	autoSetupRemote = true
