#!/bin/sh
set -eu

command_name='agent-hop'
dry_run=0
connect=1
agent=
session_id=
snapshot=
tilde='~'

usage() {
  cat <<'EOF'
usage: agent-hop [--dry-run] [--no-connect] <codex|claude> [SESSION_ID]

Copy a coding-agent session to the other workstation and continue it there.

  agent-hop codex          hop the latest Codex CLI session for this directory
  agent-hop claude         hop the latest Claude Code session for this directory
  agent-hop codex ID       hop a specific session
  agent-hop -n claude      show what would happen
  agent-hop --no-connect codex
                           copy now and connect on a later invocation

The destination gets a fork with a new session ID. The source session and both
worktrees are left unchanged. Sync project files separately when they differ.
EOF
}

die() {
  printf '%s: %s\n' "$command_name" "$*" >&2
  exit 1
}

need() {
  command -v "$1" >/dev/null 2>&1 || die "$1 is required"
}

cleanup() {
  [ -z "$snapshot" ] || rm -f -- "$snapshot"
}

shell_quote() {
  printf "'%s'" "$(printf '%s' "$1" | sed "s/'/'\\\\''/g")"
}

display_local() {
  case $1 in
    "$HOME") printf '%s' "$tilde" ;;
    "$HOME"/*) printf '%s/%s' "$tilde" "${1#"$HOME"/}" ;;
    *) printf '%s' "$1" ;;
  esac
}

display_remote() {
  case $1 in
    "$remote_home") printf '%s' "$tilde" ;;
    "$remote_home"/*) printf '%s/%s' "$tilde" "${1#"$remote_home"/}" ;;
    *) printf '%s' "$1" ;;
  esac
}

codex_cwd() {
  head -n 1 "$1" | jq -er '
    select(.type == "session_meta")
    | select(.payload.thread_source == "user")
    | select(.payload.source == "cli")
    | .payload.cwd
  ' 2>/dev/null
}

codex_id() {
  head -n 1 "$1" | jq -er '
    select(.type == "session_meta")
    | select(.payload.thread_source == "user")
    | select(.payload.source == "cli")
    | .payload.id
  ' 2>/dev/null
}

claude_cwd() {
  jq -er 'select(.cwd != null and .isSidechain != true) | .cwd' "$1" 2>/dev/null |
    head -n 1
}

latest_codex() {
  found=
  for candidate in "$HOME"/.codex/sessions/*/*/*/*.jsonl; do
    [ -f "$candidate" ] || continue
    candidate_cwd=$(codex_cwd "$candidate") || continue
    [ "$candidate_cwd" = "$current_cwd" ] || continue
    if [ -z "$found" ] || [ "$candidate" -nt "$found" ]; then
      found=$candidate
    fi
  done
  [ -n "$found" ] || die "no Codex CLI session found for $(display_local "$current_cwd")"
  printf '%s\n' "$found"
}

latest_claude() {
  found=
  for candidate in "$HOME"/.claude/projects/*/*.jsonl; do
    [ -f "$candidate" ] || continue
    candidate_cwd=$(claude_cwd "$candidate") || continue
    [ "$candidate_cwd" = "$current_cwd" ] || continue
    if [ -z "$found" ] || [ "$candidate" -nt "$found" ]; then
      found=$candidate
    fi
  done
  [ -n "$found" ] || die "no Claude Code session found for $(display_local "$current_cwd")"
  printf '%s\n' "$found"
}

find_codex() {
  found=
  for candidate in "$HOME"/.codex/sessions/*/*/*/*-"$session_id".jsonl; do
    [ -f "$candidate" ] || continue
    found=$candidate
    break
  done
  [ -n "$found" ] || die "Codex session $session_id was not found"
  [ "$(codex_id "$found")" = "$session_id" ] || die "Codex session $session_id is not resumable"
  printf '%s\n' "$found"
}

find_claude() {
  found=
  for candidate in "$HOME"/.claude/projects/*/"$session_id".jsonl; do
    [ -f "$candidate" ] || continue
    found=$candidate
    break
  done
  [ -n "$found" ] || die "Claude Code session $session_id was not found"
  printf '%s\n' "$found"
}

make_snapshot() {
  snapshot=$(mktemp "${TMPDIR:-/tmp}/agent-hop.XXXXXX") || die "could not make a session snapshot"
  trap cleanup EXIT
  trap 'exit 129' HUP
  trap 'exit 130' INT
  trap 'exit 143' TERM
  attempt=0
  while [ "$attempt" -lt 3 ]; do
    attempt=$((attempt + 1))
    cp -- "$source_file" "$snapshot" || die "could not snapshot the session"
    if jq -e . "$snapshot" >/dev/null 2>&1; then
      return
    fi
  done
  die "the session is being written; wait for the current turn to finish and try again"
}

remote_test() {
  ssh -T -o ConnectTimeout=8 -o LogLevel=ERROR "$peer" "$1"
}

remote_file_matches() {
  remote_test "test -f $(shell_quote "$destination_file") && cmp -s - $(shell_quote "$destination_file")" <"$1"
}

while [ "$#" -gt 0 ]; do
  case $1 in
    -n | --dry-run) dry_run=1 ;;
    --no-connect) connect=0 ;;
    -h | --help)
      usage
      exit 0
      ;;
    codex | claude)
      [ -z "$agent" ] || die "choose one agent"
      agent=$1
      ;;
    --) ;;
    -*) die "unknown option: $1" ;;
    *)
      [ -n "$agent" ] || die "choose codex or claude before the session ID"
      [ -z "$session_id" ] || die "only one session ID can be given"
      session_id=$1
      ;;
  esac
  shift
done

[ -n "$agent" ] || {
  usage >&2
  exit 1
}

need jq
need ssh
need rsync
need sed

case $(uname -s) in
  Darwin) peer=archie ;;
  Linux) peer=macie ;;
  *) die "this command only supports macie and archie" ;;
esac

current_cwd=$(pwd -P) || die "the current directory is gone"

if [ -n "$session_id" ]; then
  case $agent in
    codex) source_file=$(find_codex) ;;
    claude) source_file=$(find_claude) ;;
  esac
else
  case $agent in
    codex)
      source_file=$(latest_codex)
      session_id=$(codex_id "$source_file") || die "the Codex session has no ID"
      ;;
    claude)
      source_file=$(latest_claude)
      session_id=$(basename "$source_file" .jsonl)
      ;;
  esac
fi

case $agent in
  codex) source_cwd=$(codex_cwd "$source_file") || die "the Codex session has no workspace" ;;
  claude) source_cwd=$(claude_cwd "$source_file") || die "the Claude Code session has no workspace" ;;
esac

case $source_cwd in
  "$HOME") workspace_relative= ;;
  "$HOME"/*) workspace_relative=${source_cwd#"$HOME"/} ;;
  *) die "the session workspace is outside your home directory: $source_cwd" ;;
esac

remote_home_script="printf '%s\\n' \"\$HOME\""
remote_home=$(remote_test "$remote_home_script") || die "$peer is not reachable"
case $remote_home in
  /*) ;;
  *) die "$peer returned an invalid home directory" ;;
esac

if [ -n "$workspace_relative" ]; then
  destination_cwd=$remote_home/$workspace_relative
else
  destination_cwd=$remote_home
fi

remote_test "test -d $(shell_quote "$destination_cwd")" >/dev/null 2>&1 ||
  die "workspace does not exist on $peer: $(display_remote "$destination_cwd")"
remote_test "command -v $agent >/dev/null 2>&1 && command -v zsh >/dev/null 2>&1" >/dev/null 2>&1 ||
  die "$agent or zsh is not available on $peer"

case $agent in
  codex)
    relative_file=${source_file#"$HOME/.codex/"}
    destination_file=$remote_home/.codex/$relative_file
    destination_dir=${destination_file%/*}
    source_companion=
    destination_companion=
    inner_command="codex fork $(shell_quote "$session_id") -C $(shell_quote "$destination_cwd")"
    ;;
  claude)
    project_key=$(printf '%s' "$destination_cwd" | sed 's/[^A-Za-z0-9_-]/-/g')
    destination_dir=$remote_home/.claude/projects/$project_key
    destination_file=$destination_dir/$session_id.jsonl
    source_companion=${source_file%.jsonl}
    destination_companion=$destination_dir/$session_id
    inner_command="claude --resume $(shell_quote "$session_id") --fork-session"
    ;;
esac

printf '%-11s %s -> %s\n' agent "$agent on $(uname -n)" "$peer"
printf '%-11s %s\n' session "$session_id"
printf '%-11s %s -> %s\n' workspace "$(display_local "$source_cwd")" "$(display_remote "$destination_cwd")"
printf '%-11s %s -> %s\n' transcript "$(display_local "$source_file")" "$(display_remote "$destination_file")"
printf '%-11s %s\n' continuation 'fork with a new session ID'
printf '%-11s %s\n' worktree 'not synchronized'

transfer_source=$source_file
if [ "$dry_run" -eq 0 ]; then
  make_snapshot
  transfer_source=$snapshot
fi

reuse=0
if remote_test "test -e $(shell_quote "$destination_file")" >/dev/null 2>&1; then
  if remote_file_matches "$transfer_source"; then
    reuse=1
  else
    die "session $session_id already exists with different contents on $peer"
  fi
fi

if [ "$dry_run" -eq 1 ]; then
  [ "$reuse" -eq 1 ] && printf '%s\n' "status      identical transcript already exists on $peer"
  printf '%s\n' 'status      dry run; nothing copied or started'
  exit 0
fi

remote_test "mkdir -p -- $(shell_quote "$destination_dir")" >/dev/null ||
  die "could not create the session directory on $peer"

if [ "$reuse" -eq 0 ]; then
  rsync -a -e 'ssh -o ConnectTimeout=8' -- "$transfer_source" "$peer:$(shell_quote "$destination_file")" ||
    die "could not copy the transcript to $peer"
else
  printf '%s\n' "status      reusing identical transcript on $peer"
fi

if [ -n "$source_companion" ] && [ -d "$source_companion" ]; then
  rsync -a -e 'ssh -o ConnectTimeout=8' -- "$source_companion/" "$peer:$(shell_quote "$destination_companion")/" ||
    die "could not copy the session attachments to $peer"
fi

if [ "$connect" -eq 0 ]; then
  printf '%s\n' "status      copied; rerun without --no-connect to open on $peer"
  exit 0
fi

remote_launch="cd $(shell_quote "$destination_cwd") && exec zsh -lic $(shell_quote "$inner_command")"
exec ssh -tt -o ConnectTimeout=8 -o LogLevel=ERROR "$peer" "$remote_launch"
