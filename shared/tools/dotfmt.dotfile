{
  width          = 120
  final_newline  = false
  quote_style    = double
}

conf {
  excluded_files {
    **/ssh/bin/
  }
}

env {
  final_newline  = true
}

ignore {
  final_newline    = true
  align            = true
  format_comments  = true
}

ini {
  final_newline  = true
  align          = true
}

plist {
  final_newline  = true
  indent         = 2
}

markdown {
  width        = 80
  table_style  = compact
}

json {
  final_newline  = true
}

lua {}

toml {
  width                 = 120
  align_entries         = true
  array_trailing_comma  = true
  allowed_blank_lines   = 1
}

yaml {
  excluded_files {
    .sops.yaml
    *.enc.yaml
    *.enc.yml
    **/gh/hosts.yml
  }
}

latex {
  width          = 100
  indent         = 2
  wrap           = true
  format_tables  = false
}

bib {
  indent          = 2
  align           = true
  trailing_comma  = false
  blank_lines     = 1
}