{
  width          = 120
  final_newline  = false
  quote_style    = double
}

conf {
  included_files {
    **/ssh/config
    **/ssh/config.d/*
  }
  excluded_files {
    **/ssh/bin/
  }
}

markdown {
  width  = 80
  excluded_files {
    AGENTS.md
    CLAUDE.md
  }
}

json {
  final_newline  = true
}

lua {}

yaml {
  excluded_files {
    .sops.yaml
    *.enc.yaml
    *.enc.yml
    **/gh/hosts.yml
  }
}