# Formats: `.conf`, `.config` and `.dotfile`.
#   dotfmt    the .dotfile block formatter
#   include   which files dotfmt owns, in .gitignore syntax
#   exclude   applied after include; a file must match one and not the other

dotfmt {
  indent         = 2
  align          = true
  align_max      = 24
  blank_lines    = 1
  final_newline  = false
}

include {
  .conf
  .config
  ssh/_empty_
}

exclude {
  **/ssh/bin/
}