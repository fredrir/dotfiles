{
  width          = 120
  final_newline  = false
  quote_style    = double
}

conf {
  excluded_files {
    **/ssh/bin/
  }
}

env {
  final_newline  = true
  align          = true
}

ignore {
  final_newline    = true
  align            = true
  format_comments  = true
}

ini {
  final_newline  = true
  align          = true
}

plist {
  final_newline  = true
  indent         = 2
}

markdown {
  width        = 80
  table_style  = compact
}

json {
  final_newline  = true
}

lua {}

toml {
  width                 = 120
  align_entries         = true
  array_trailing_comma  = true
  allowed_blank_lines   = 1
}

yaml {
  excluded_files {
    .sops.yaml
    *.enc.yaml
    *.enc.yml
    **/gh/hosts.yml
  }
}

latex {
  width          = 100
  indent         = 2
  wrap           = true
  format_tables  = false
}

bib {
  indent          = 2
  align           = true
  trailing_comma  = false
  blank_lines     = 1
}

typescript {
  width                 = 80
  final_newline         = true
  quote_style           = double
  jsx_quote_style       = double
  semicolons            = always
  trailing_commas       = all
  arrow_parentheses     = always
  bracket_spacing       = true
  sort_imports          = false
  tailwind              = auto
  tailwind_dedupe       = true
  tailwind_functions    = "cn, clsx, cva, twMerge"
  tailwind_attributes   = "class, className"
  type_aware            = true
}

css {
  width           = 80
  final_newline   = true
  tailwind        = auto
  tailwind_dedupe = true
}

html {
  width           = 80
  final_newline   = true
  tailwind        = auto
  tailwind_dedupe = true
}
