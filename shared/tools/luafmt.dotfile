luafmt {
  dialect                    = auto
  width                      = 120
  indent                     = 2
  indent_type                = spaces
  line_endings               = unix
  quote_style                = auto-prefer-double
  call_parentheses           = none
  collapse_simple_statement  = never
  space_after_function_names = never
  block_newline_gaps         = never
  sort_requires              = false
  final_newline              = false
  verify                     = false
}

whitelist {
  # Empty allows all Lua files.
}

blacklist {
  # Example: vendor/
}
