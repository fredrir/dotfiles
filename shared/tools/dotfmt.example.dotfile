{
  # width = 80                   # Lua lines / Markdown tables / YAML flow collections / TOML arrays / inline tables
  # indent = 2                   # conf / JSON / Lua / TOML / YAML
  # final_newline = false        # true | false
  # quote_style = double         # double | single | auto | auto-prefer-double | auto-prefer-single; TOML preserves quoting
}

conf {
  enabled        = true  # true | false
  indent         = 2     # spaces per nesting level
  align          = true  # true | false (.dotfile)
  align_max      = 24    # key alignment width (.dotfile)
  blank_lines    = 1     # max consecutive blank lines
  final_newline  = false # true | false

  included_files {} # files to beyond what's supported; gitignore syntax
  excluded_files {} # gitignore syntax
}

markdown {
  enabled                   = true  # true | false
  dialect                   = auto  # auto | commonmark | gfm | obsidian
  width                     = 80    # 0..10000; table width, 0 = unlimited
  table_style               = auto  # auto | aligned | compact
  autosize_table            = false # true | false; size dividers to aligned columns
  blank_lines               = 1     # 1..3; max consecutive blank lines
  heading_blank_lines       = 1     # 0..3; after headings
  list_marker               = -     # - | * | +
  trim_trailing_blank_lines = true  # true | false
  final_newline             = false # true | false

  included_files {}
  excluded_files {}
}

json {
  enabled        = true   # true | false
  dialect        = auto   # auto | json | jsonc | hujson (jwcc) | jsonl (ndjson)
  indent         = 2      # -1 = tabs; 0 = compact; 1..7 = spaces; jsonl is always compact
  quote_style    = double # double only
  final_newline  = true   # true | false

  included_files {}
  excluded_files {}
}

lua {
  enabled                   = true               # true | false
  dialect                   = auto               # auto | all | lua51 | lua52 | lua53 | lua54 | luajit | luau
  width                     = 120                # line width
  indent                    = 2                  # 1..16; spaces / tab width
  indent_type               = spaces             # spaces | tabs
  line_endings              = unix               # unix | windows
  quote_style               = auto-prefer-double # auto-prefer-double | auto-prefer-single | double | single
  call_parentheses          = none               # always | no-single-string | no-single-table | none | input
  collapse_simple_statement = never              # never | function-only | conditional-only | always
  space_after_function_names = never             # never | definitions | calls | always
  block_newline_gaps        = never              # never | preserve
  sort_requires             = false              # true | false
  final_newline             = false              # true | false
  verify                    = false              # true | false; reparse formatted output

  included_files {}
  excluded_files {}
}

toml {
  enabled                = true  # true | false
  indent                 = 2     # 1..16; spaces / tab width
  width                  = 80    # 1..10000; arrays / inline tables
  final_newline          = true  # true | false
  line_endings           = unix  # unix | windows
  allowed_blank_lines    = 1     # 0..10
  align_entries          = false # true | false
  align_comments         = true  # true | false
  align_single_comments  = true  # true | false
  array_trailing_comma   = true  # true | false
  array_auto_expand      = true  # true | false
  array_auto_collapse    = true  # true | false
  compact_arrays         = true  # true | false
  compact_inline_tables  = false # true | false
  compact_entries        = false # true | false
  inline_table_expand    = true  # true | false
  indent_tables          = false # true | false
  indent_entries         = false # true | false
  reorder_keys           = false # true | false
  format_comments        = false # true | false; space after #

  included_files {}
  excluded_files {}
}

yaml {
  enabled             = true               # true | false
  width               = 80                 # 1..10000; wraps flow collections, never scalars
  indent              = 2                  # 1..16 spaces
  quote_style         = auto-prefer-double # auto-prefer-double | auto-prefer-single | double | single
  line_endings        = unix               # unix | windows
  indent_sequences    = true               # true | false; indent sequences inside mappings
  trailing_comma      = false              # true | false; wrapped flow collections
  brace_spacing       = false              # true | false; { a: 1 }
  bracket_spacing     = false              # true | false; [ 1 ]
  dash_spacing        = one-space          # one-space | indent
  prefer_single_line  = false              # true | false; join multi-line flow collections that fit
  format_comments     = false              # true | false; space after #
  final_newline       = true               # true | false

  included_files {}
  excluded_files {}
}

# gitignore syntax
# an empty block will reset inherited rules
included_files { # empty = all configured languages
  # src/**
}

excluded_files {
  # vendor/
}