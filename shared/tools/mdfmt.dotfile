mdfmt {
  dialect                   = auto
  width                     = 80
  table_style               = auto
  heading_blank_lines       = 1
  list_marker               = -
  trim_trailing_blank_lines = true
  final_newline             = false
}

whitelist {
  # Empty allows all files. Example: docs/
}

blacklist {
  # Example: generated/
}
