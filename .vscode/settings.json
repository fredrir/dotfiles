{
  "rust-analyzer.linkedProjects": [
    "scripts/rust/Cargo.toml"
  ],
  "ruff.configuration": "${workspaceFolder}/scripts/python/pyproject.toml",
  "ruff.configurationPreference": "filesystemFirst",
  "Lua.runtime.version": "LuaJIT",
  "Lua.runtime.path": [
    "?.lua",
    "?/init.lua",
    "shared/nvim/lua/?.lua",
    "shared/nvim/lua/?/init.lua",
    "shared/wezterm/?.lua",
    "shared/wezterm/?/init.lua"
  ],
  "Lua.workspace.library": [
    "${workspaceFolder}/shared/wezterm/lua_modules/share/lua/5.5/wezterm/types",
    "${workspaceFolder}/shared/wezterm/_types",
    "/opt/homebrew/share/nvim/runtime/lua",
    "/usr/local/share/nvim/runtime/lua",
    "/usr/share/nvim/runtime/lua",
    "${env:HOME}/.local/share/nvim/lazy/lazy.nvim/lua",
    "${env:HOME}/.local/share/nvim/lazy/blink.cmp/lua",
    "${env:HOME}/.local/share/nvim/lazy/conform.nvim/lua",
    "${env:HOME}/.local/share/nvim/lazy/gitsigns.nvim/lua",
    "${env:HOME}/.local/share/nvim/lazy/harpoon/lua",
    "${env:HOME}/.local/share/nvim/lazy/neo-tree.nvim/lua"
  ],
  "Lua.workspace.checkThirdParty": false,
  "Lua.workspace.ignoreDir": [
    ".git",
    ".uv",
    "scripts/python/.venv",
    "scripts/rust/target"
  ],
  "Lua.diagnostics.unusedLocalExclude": [
    "_*"
  ],
  "Lua.format.enable": false,
  "Lua.telemetry.enable": false,
  "Lua.type.checkTableShape": true,
  "Lua.type.inferParamType": true
}
