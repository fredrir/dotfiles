#   name                    a command that has to be on PATH
#   name = package          ... installed under a different package name
#   name = manager:package  ... provided by aur, pacman, apt, brew, cargo or uv
#                           instead of the platform's package manager
#   font <family>           a font family the configs ask for by name
#   file <path>             a path that has to exist but is not tracked here
#   ?name                   wanted but not required: reported, never a failure
#   A later block refines an earlier entry with the same name.

shared {
  git
  curl
  bash
  python3
  ssh   = openssh
  zsh
  uv
  age
  sops
  nvim  = neovim
  yazi
  starship
  fastfetch
  lazygit
  fzf
  eza
  bat
  fd
  rg    = ripgrep
  rsync
  zoxide
  direnv
  openssl
  jq
  ?wezterm
  ?ncdu
  ?gh   = github-cli
  ?docker
  ?fio
  ?sysbench
  ?hyperfine
  ?stress-ng
  ?7z   = 7zip
  ?portview
  ?kondo
  ?shucked
  ?biome
  ?ruff
  ?stylua
  ?taplo
  ?yamlfmt
  ?yamllint
  ?sqlfluff
}

macos {
  brew                      = homebrew
  mosh
  socat
  ?gh                       = gh
  ?7z                       = sevenzip
  font Hack Nerd Font Mono  = font-hack-nerd-font
  font JetBrains Mono       = font-jetbrains-mono
  font Noto Sans            = font-noto-sans
}

linux/common {
  ?sensors  = lm_sensors
}

linux/arch {
  dnsmasq
  hostapd
  iw
  nmcli               = networkmanager
  nft                 = nftables
  iptables
  mosh
  socat
  avahi-daemon        = avahi
  wezterm-mux-server  = aur:wezterm-nightly-bin
  fan2go              = aur:fan2go-git
  lact
  nvme                = nvme-cli
  fwupdmgr            = fwupd
  mold
  sccache
  taskset             = util-linux
  ?memtester
  ?y-cruncher         = aur:y-cruncher
  ?llama-cli          = aur:llama.cpp-cuda
}

linux/kde {
  plasmashell               = plasma-desktop
  konsole
  kate
  ?dolphin
  flameshot
  xremap                    = aur:xremap-kde-bin
  fc-cache                  = fontconfig
  wl-copy                   = wl-clipboard
  wl-paste                  = wl-clipboard
  ?glmark2
  ?vkmark
  font Hack Nerd Font Mono  = ttf-hack-nerd
  font JetBrains Mono       = ttf-jetbrains-mono
  font Noto Sans            = noto-fonts
}

linux/hyprland {
  Hyprland                  = hyprland
  hyprlock
  hypridle
  waybar
  dunst
  wofi
  wlogout
  walker
  elephant
  swaybg
  qt5ct
  qt6ct
  flameshot
  xremap                    = aur:xremap-hypr-bin
  fc-cache                  = fontconfig
  wl-copy                   = wl-clipboard
  wl-paste                  = wl-clipboard
  ?cliphist
  ?grimblast
  ?brightnessctl
  ?playerctl
  ?hyprsunset
  ?glmark2
  ?vkmark
  font Hack Nerd Font Mono  = ttf-hack-nerd
  font JetBrains Mono       = ttf-jetbrains-mono
  font JetBrainsMono Nerd Font = ttf-jetbrains-mono-nerd
  font Noto Sans            = noto-fonts
  file ~/.config/hypr/wallpaper.png
}