live {
  base_boost_mhz  = 5200
  memory_mts      = 6000
  gpu             = 0000:01:00.0
}

memory {
  Ai Overclock Tuner        = EXPO I
  Memory Frequency          = DDR5-6000MHz
  FCLK Frequency            = Auto
  UCLK DIV1 MODE#1          = Auto
  Memory Context Restore#1  = Enabled
  Power Down Enable#1       = Enabled
  Tcl                       = 30
  Trcd Wr                   = 36
  Trcd Rd                   = 36
  Trp                       = 36
  Tras                      = 76
  DRAM VDD Voltage          = 1.40000
  DRAM VDDQ Voltage         = 1.40000
}

pbo {
  Precision Boost Overdrive#1 = Enabled
  Precision Boost Overdrive Scalar = Auto
  CPU Boost Clock Override#1 = Enabled (Positive)
  Max CPU Boost Clock Override(+)#1 = Auto
  Platform Thermal Throttle Limit#1 = Manual
  Platform Thermal Throttle Limit#2 = 85
  Curve Optimizer#1         = All Cores
  All Core Curve Optimizer Sign = Negative
  All Core Curve Optimizer Magnitude = 25
}

platform {
  SVM Mode            = Enabled
  Above 4G Decoding   = Enabled
  Resize BAR Support  = Enabled
  Launch CSM          = Disabled
  Fast Boot           = Enabled
}

