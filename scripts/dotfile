#!/usr/bin/env bash
set -euo pipefail
shopt -s dotglob nullglob

if [ "${BASH_VERSINFO[0]:-0}" -lt 4 ] ||
   { [ "${BASH_VERSINFO[0]}" -eq 4 ] && [ "${BASH_VERSINFO[1]}" -lt 4 ]; }; then
  printf 'dotfile: needs bash 4.4 or newer (found %s)\n' "${BASH_VERSION:-unknown}" >&2
  exit 1
fi

SELF="${BASH_SOURCE[0]}"
while [ -L "$SELF" ]; do
  TARGET="$(readlink "$SELF")"
  case "$TARGET" in
    /*) SELF="$TARGET" ;;
    *) SELF="$(dirname "$SELF")/$TARGET" ;;
  esac
done
BIN="$(cd "$(dirname "$SELF")" && pwd -P)"
LIB="$BIN/lib"

if [ -n "${DOTFILE_ROOT:-}" ]; then
  DOTFILES="$(cd "$DOTFILE_ROOT" && pwd -P)"
else
  DOTFILES="$(cd "$BIN/.." && pwd -P)"
fi

TARGETS_FILE="$DOTFILES/targets"
PACKAGES_CONFIG="$DOTFILES/packages.dotfile"
PACKAGES_DOC="$DOTFILES/PACKAGES.md"
STATE_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/dotfile"
OVERRIDES_FILE="$STATE_DIR/overrides"

source "$LIB/common.sh"
source "$LIB/targets.sh"
source "$LIB/state.sh"
source "$LIB/link.sh"
source "$LIB/packages.sh"
source "$LIB/format.sh"
source "$LIB/adopt.sh"
source "$LIB/remove.sh"

usage() {
  cat <<'EOF'
usage: dotfile <command> [args]

commands:
  link [profile] [-n]   symlink every package in the profile manifest into $HOME
  add [flags] <path>    move a live config into the repo and symlink it back
  remove <path>         move a tracked path out of the repo and keep it live
  packages              regenerate packages.dotfile and PACKAGES.md
  format [path ...]     format tracked .conf files or the selected files
  status [profile]      show link state for every file in the profile
  help                  show this help

link flags:
  -n, --dry-run                   print actions without changing anything
  --override <group>=<name|none>  pick a machine override set for a group

add flags:
  --shared (default)  --linux  --kde  --hyprland  --server  --macos
  --pkg <name>        override the package name
  --description <text>  describe the package in PACKAGES.md

examples:
  dotfile link arch-linux/kde
  dotfile link --override linux/hyprland=laptop
  dotfile add waybar
  dotfile add --description "Status bar" waybar
  dotfile add --linux zsh/conf.d/11-linux-env
  dotfile add --pkg zsh ~/.zshrc
  dotfile remove linux/common/fontconfig
  dotfile remove /linux/server/zsh/conf.d/10-nvim.server.zsh
  dotfile packages
  dotfile format
EOF
}

command="${1:-help}"
shift || true
case "$command" in
  link) cmd_link "$@" ;;
  add) cmd_add "$@" ;;
  remove) cmd_remove "$@" ;;
  packages) cmd_packages "$@" ;;
  format) cmd_format "$@" ;;
  status) cmd_status "$@" ;;
  help|-h|--help) usage ;;
  *)
    usage >&2
    exit 1
    ;;
esac
