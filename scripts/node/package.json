{
  "name": "dotfiles",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "lint": "oxlint && bun check",
    "build": "bun run --cwd packages/dot-code build && bun run --cwd packages/dotfmt build",
    "deploy": "bun run --cwd packages/dot-code deploy && bun run --cwd packages/dotfmt deploy",
    "format": "prettier -w . && dotfmt -l md -l json ."
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@types/bun": "latest",
    "@types/node": "^26.6.5",
    "@types/vscode": "^1.140.0",
    "@vscode/vsce": "^4.0.0",
    "globals": "^17.13.0",
    "jiti": "^2.7.0",
    "oxlint": "^1.91.0",
    "oxlint-tsgolint": "^7.0.2005",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "zod": "^4.6.7"
  }
}
