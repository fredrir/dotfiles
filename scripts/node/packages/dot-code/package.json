{
  "name": "dot-code",
  "displayName": "Dot Code",
  "description": "Native refactors backed by a Rust language server",
  "version": "0.1.0",
  "publisher": "fredrir",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/fredrir/dotfiles"
  },
  "scripts": {
    "build": "bun build.ts",
    "deploy": "bun deploy.ts",
    "check-types": "tsc --noEmit -p ."
  },
  "dependencies": {
    "picomatch": "^4.0.7",
    "vscode-languageclient": "^11.0.0"
  },
  "devDependencies": {
    "@types/picomatch": "^4.0.3",
    "@types/vscode": "^1.140.0",
    "@vscode/vsce": "^4.0.0"
  },
  "engines": {
    "vscode": "^1.143.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "extensionKind": [
    "workspace"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onLanguage:typescript",
    "onLanguage:typescriptreact"
  ],
  "contributes": {
    "commands": [
      {
        "command": "dotCode.extractInterface",
        "title": "Extract Interface",
        "category": "Dot Code"
      },
      {
        "command": "dotCode.extractType",
        "title": "Extract Type Alias",
        "category": "Dot Code"
      },
      {
        "command": "dotCode.convertType",
        "title": "Convert Type / Interface",
        "category": "Dot Code"
      },
      {
        "command": "dotCode.nextFile",
        "title": "Next File in Directory",
        "category": "Dot Code"
      },
      {
        "command": "dotCode.previousFile",
        "title": "Previous File in Directory",
        "category": "Dot Code"
      },
      {
        "command": "dotCode.restart",
        "title": "Restart Server",
        "category": "Dot Code"
      },
      {
        "command": "dotCode.showVersion",
        "title": "Show Version",
        "category": "Dot Code"
      }
    ],
    "keybindings": [
      {
        "command": "dotCode.extractInterface",
        "key": "shift+alt+x",
        "when": "editorTextFocus && !editorReadonly && editorLangId =~ /^typescript(react)?$/"
      },
      {
        "command": "dotCode.extractType",
        "key": "shift+alt+cmd+x",
        "when": "editorTextFocus && !editorReadonly && editorLangId =~ /^typescript(react)?$/"
      },
      {
        "command": "dotCode.convertType",
        "key": "shift+alt+cmd+t",
        "when": "editorTextFocus && !editorReadonly && editorLangId =~ /^typescript(react)?$/"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "dotCode.extractInterface",
          "group": "1_modification@3",
          "when": "!editorReadonly && editorLangId =~ /^typescript(react)?$/"
        },
        {
          "command": "dotCode.extractType",
          "group": "1_modification@3.1",
          "when": "!editorReadonly && editorLangId =~ /^typescript(react)?$/"
        },
        {
          "command": "dotCode.convertType",
          "group": "1_modification@3.2",
          "when": "!editorReadonly && editorLangId =~ /^typescript(react)?$/"
        }
      ],
      "commandPalette": [
        {
          "command": "dotCode.extractInterface",
          "when": "editorLangId =~ /^typescript(react)?$/"
        },
        {
          "command": "dotCode.extractType",
          "when": "editorLangId =~ /^typescript(react)?$/"
        },
        {
          "command": "dotCode.convertType",
          "when": "editorLangId =~ /^typescript(react)?$/"
        }
      ]
    },
    "configuration": {
      "title": "Dot Code",
      "properties": {
        "dotCode.server.path": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "description": "Server binary; empty uses the bundled one"
        },
        "dotCode.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Traces server communication"
        },
        "dotCode.typescript.extract.name": {
          "type": "string",
          "default": "Props",
          "markdownDescription": "Name of selected extracted type: `${name}`"
        },
        "dotCode.typescript.extract.export": {
          "type": "string",
          "enum": [
            "never",
            "always",
            "inherit"
          ],
          "enumDescriptions": [
            "Never export",
            "Export at module level",
            "Export when the source statement is exported"
          ],
          "default": "never",
          "description": "Export extracted types"
        },
        "dotCode.typescript.extract.rename": {
          "type": "boolean",
          "default": true,
          "description": "Rename extracted types right away"
        }
      }
    }
  }
}
