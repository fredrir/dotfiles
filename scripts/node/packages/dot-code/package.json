{
  "name": "dot-code",
  "displayName": "Dot Code",
  "description": "Native refactors backed by a Rust language server",
  "version": "0.1.0",
  "publisher": "fredrir",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/fredrir/dotfiles"
  },
  "engines": {
    "vscode": "^1.143.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "extensionKind": [
    "workspace"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onLanguage:typescript",
    "onLanguage:typescriptreact"
  ],
  "contributes": {
    "commands": [
      {
        "command": "dotCode.restart",
        "title": "Restart Server",
        "category": "Dot Code"
      }
    ],
    "configuration": {
      "title": "Dot Code",
      "properties": {
        "dotCode.server.path": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "description": "Server binary; empty uses the bundled one"
        },
        "dotCode.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Traces server communication"
        },
        "dotCode.typescript.extract.name": {
          "type": "string",
          "default": "Props",
          "markdownDescription": "Name for extracted types; `${name}` expands to the enclosing function, class or variable"
        },
        "dotCode.typescript.extract.export": {
          "type": "string",
          "enum": [
            "never",
            "always",
            "inherit"
          ],
          "enumDescriptions": [
            "Never export",
            "Export at module level",
            "Export when the source statement is exported"
          ],
          "default": "never",
          "description": "Export extracted types"
        },
        "dotCode.typescript.extract.rename": {
          "type": "boolean",
          "default": true,
          "description": "Rename extracted types right away"
        }
      }
    }
  },
  "scripts": {
    "build": "bun build.ts",
    "deploy": "bun deploy.ts",
    "check-types": "tsc --noEmit -p ."
  },
  "dependencies": {
    "vscode-languageclient": "^11.0.0"
  },
  "devDependencies": {
    "@types/vscode": "^1.140.0",
    "@vscode/vsce": "^4.0.0"
  }
}
