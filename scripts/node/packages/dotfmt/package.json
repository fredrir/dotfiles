{
  "name": "dotfmt",
  "displayName": "dotfmt",
  "description": "Formatter for config, data, markup, TypeScript/TSX, JavaScript/JSX, CSS and Tailwind; errors only, never lints",
  "version": "0.3.0",
  "publisher": "fredrir",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/fredrir/dotfiles"
  },
  "scripts": {
    "build": "bun build.ts",
    "deploy": "bun deploy.ts",
    "test": "bun test"
  },
  "dependencies": {
    "vscode-languageclient": "^11.0.0"
  },
  "devDependencies": {
    "@types/vscode": "^1.145.0",
    "@vscode/vsce": "^4.1.0"
  },
  "engines": {
    "vscode": "^1.145.0"
  },
  "categories": [
    "Formatters"
  ],
  "extensionKind": [
    "workspace"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onLanguage:astro",
    "onLanguage:bibtex",
    "onLanguage:chatagent",
    "onLanguage:css",
    "onLanguage:dockercompose",
    "onLanguage:dotenv",
    "onLanguage:dotfile",
    "onLanguage:html",
    "onLanguage:ignore",
    "onLanguage:ini",
    "onLanguage:instructions",
    "onLanguage:javascript",
    "onLanguage:javascriptreact",
    "onLanguage:json",
    "onLanguage:jsonc",
    "onLanguage:jsonl",
    "onLanguage:latex",
    "onLanguage:less",
    "onLanguage:lua",
    "onLanguage:markdown",
    "onLanguage:prompt",
    "onLanguage:properties",
    "onLanguage:sass",
    "onLanguage:scss",
    "onLanguage:skill",
    "onLanguage:svelte",
    "onLanguage:tex",
    "onLanguage:toml",
    "onLanguage:typescript",
    "onLanguage:typescriptreact",
    "onLanguage:vue",
    "onLanguage:yaml"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Workspace settings cannot choose the dotfmt or language server binary or the TypeScript compiler. Type-aware checks and unsafe fixes stay disabled; formatting still works.",
      "restrictedConfigurations": [
        "dotfmt.path",
        "dotfmt.server.path",
        "dotfmt.typescript.tsdk"
      ]
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "dotfmt resolves configuration from files on disk."
    }
  },
  "contributes": {
    "languages": [
      {
        "id": "dotfile",
        "aliases": [
          "Dotfile",
          "dotfile"
        ],
        "extensions": [
          ".dotfile"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "dotfile",
        "scopeName": "source.dotfile",
        "path": "./syntaxes/dotfile.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "dotfmt.fixAll",
        "title": "Fix All",
        "category": "dotfmt"
      },
      {
        "command": "dotfmt.organizeImports",
        "title": "Organize Imports",
        "category": "dotfmt"
      },
      {
        "command": "dotfmt.sortTailwind",
        "title": "Sort Tailwind Classes",
        "category": "dotfmt"
      },
      {
        "command": "dotfmt.restartServer",
        "title": "Restart Language Server",
        "category": "dotfmt"
      },
      {
        "command": "dotfmt.showOutput",
        "title": "Show Output",
        "category": "dotfmt"
      },
      {
        "command": "dotfmt.showStatus",
        "title": "Show Status",
        "category": "dotfmt"
      },
      {
        "command": "dotfmt.setAsDefaultFormatter",
        "title": "Set as Default Formatter",
        "category": "dotfmt"
      },
      {
        "command": "dotfmt.openConfig",
        "title": "Open Configuration",
        "category": "dotfmt"
      },
      {
        "command": "dotfmt.doctor",
        "title": "Doctor",
        "category": "dotfmt"
      }
    ],
    "configuration": {
      "title": "dotfmt",
      "properties": {
        "dotfmt.typeAware": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "markdownDescription": "Run the TypeScript compiler for the nearest project. **Errors only**: type errors become diagnostics, and unused-code or lint findings are never published as diagnostics."
        },
        "dotfmt.diagnostics.syntax": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "markdownDescription": "Publish fatal syntax and configuration errors. Set to `false` to silence all dotfmt diagnostics for this resource."
        },
        "dotfmt.diagnostics.tscScope": {
          "type": "string",
          "enum": [
            "open",
            "project"
          ],
          "enumDescriptions": [
            "Check open TypeScript/JavaScript documents only",
            "Check every file in the TypeScript project"
          ],
          "default": "open",
          "scope": "resource",
          "markdownDescription": "Which files receive TypeScript compiler errors when `dotfmt.typeAware` is on. `open` keeps diagnostics to open documents; `project` publishes errors for the whole project."
        },
        "dotfmt.diagnostics.debounceMs": {
          "type": "number",
          "minimum": 50,
          "maximum": 2000,
          "default": 250,
          "scope": "resource",
          "markdownDescription": "Delay in milliseconds before TypeScript checks run again after an edit."
        },
        "dotfmt.typescript.tsdk": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "markdownDescription": "Path to a TypeScript installation's `lib` directory (for example `node_modules/typescript/lib`). Empty auto-discovers the project's compiler. The workspace value is ignored in untrusted workspaces."
        },
        "dotfmt.fixes.onSave": {
          "type": "string",
          "enum": [
            "off",
            "safe",
            "unsafe"
          ],
          "enumDescriptions": [
            "Do not fix on save",
            "Apply safe fixes and formatting on save",
            "Apply safe and unsafe fixes and formatting on save"
          ],
          "default": "off",
          "scope": "resource",
          "markdownDescription": "Apply the selected fixes through `textDocument/willSaveWaitUntil`, before the file is written. Alternatively use `editor.codeActionsOnSave` with `source.fixAll.dotfmt`, `source.organizeImports.dotfmt` or `source.format.dotfmt`."
        },
        "dotfmt.path": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "description": "dotfmt CLI binary shown in status and doctor; empty uses the bundled one"
        },
        "dotfmt.server.path": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "description": "dotfmt language server binary; empty uses the bundled one"
        },
        "dotfmt.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "scope": "window",
          "description": "Trace LSP communication with the dotfmt language server in the dotfmt trace output channel"
        }
      }
    }
  }
}
