+func (g *Gui) drawFrameHandle(v *View, bgColor Attribute) {
+	handle := v.FrameHandle
+	for i, ch := range handle.Runes {
+		x, y := handle.Start+i, handle.Start+i
+		switch handle.Edge {
+		case TOP:
+			y = v.y0
+		case BOTTOM:
+			y = v.y1
+		case LEFT:
+			x = v.x0
+		case RIGHT:
+			x = v.x1
