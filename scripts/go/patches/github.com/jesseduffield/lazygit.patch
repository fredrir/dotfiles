+	self.c.LogAction(self.c.Tr.Actions.Commit)
+	started := time.Now()
+	committed := false
+	err := self.c.RunSubprocessAndRefresh(cmdObj.FinishQuietlyIf(func(err error) bool {
+		committed = err == nil
+		return committed || self.commitMessageLeftEmptySince(started)
+	}))
+	if committed {
+		self.c.SuccessToast("committed")
+	}
+	return err
+}
+
+func (self *WorkingTreeHelper) commitMessageLeftEmptySince(started time.Time) bool {
+	path := filepath.Join(self.c.Git().RepoPaths.WorktreeGitDirPath(), "COMMIT_EDITMSG")
+	info, err := os.Stat(path)
+	if err != nil || info.ModTime().Before(started) {
+		return false
+	}
+	content, err := os.ReadFile(path)
+	if err != nil {
+		return false
+	}
+	commentChar := string(self.c.Git().Config.GetCoreCommentChar())
+	message, _, _ := strings.Cut(string(content), commentChar+" ------------------------ >8 ------------------------")
+	return lo.EveryBy(strings.Split(message, "\n"), func(line string) bool {
+		return strings.HasPrefix(line, commentChar) || strings.TrimSpace(line) == ""
 	})
 }
 
