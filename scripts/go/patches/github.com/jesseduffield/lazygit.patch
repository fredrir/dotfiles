+func draggedSidePanelBoxes(args WindowArrangementArgs, windows []string, height int) ([]*boxlayout.Box, bool) {
+	heights := args.PanelSizes.SidePanelHeights
+	sizes, ok := fitSizes(lo.Map(windows, func(window string, _ int) float64 { return float64(heights[window]) }), height)
+	if !ok {
