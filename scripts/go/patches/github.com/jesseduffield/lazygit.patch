+
+// fitSizes scales shares to sizes that add up to length exactly, so boxlayout reproduces them when given as weights.
+func fitSizes(shares []float64, length int) ([]int, bool) {
+	if length < len(shares)*MinPanelSize || lo.SomeBy(shares, func(share float64) bool { return share <= 0 }) {
+		return nil, false
+	}
+	total := lo.Sum(shares)
+	sizes := make([]int, len(shares))
+	cumulative, boundary := 0.0, 0
+	for i, share := range shares {
+		cumulative += share
+		next := int(math.Round(cumulative / total * float64(length)))
+		sizes[i] = next - boundary
+		boundary = next
+	}
+	for i := range sizes {
+		for sizes[i] < MinPanelSize {
+			sizes[slices.Index(sizes, slices.Max(sizes))]--
+			sizes[i]++
+		}
+	}
+	return sizes, true
