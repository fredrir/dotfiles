+package status
+
+import (
+	"strings"
+	"time"
+	"unicode"
+
+	"github.com/jesseduffield/lazygit/pkg/gocui"
+	"github.com/jesseduffield/lazygit/pkg/utils"
+)
+
+const toastFadeDuration = 150 * time.Millisecond
+
+// ToastAnimation is owned by the UI thread. Changing status keeps the same
+// surface alive, including when a waiting operation becomes a success toast.
+type ToastAnimation struct {
+	message                           string
+	width                             int
+	shownAt, hiddenAt, colorChangedAt time.Time
+	fromColor, color                  gocui.Attribute
+}
+
+type ToastFrame struct {
+	Visible                bool
+	X, Width               int
+	Content                string
+	Foreground, Background gocui.Attribute
+}
+
+func (self *ToastAnimation) Active() bool {
+	return self.message != ""
+}
+
+func (self *ToastAnimation) Frame(now time.Time, message string, color gocui.Attribute, screenWidth, screenHeight int) ToastFrame {
+	if message != "" {
+		if !self.Active() {
+			self.shownAt = now
+			self.width = 0
+			self.fromColor, self.color = color, color
+		}
+		self.hiddenAt = time.Time{}
+		self.message = strings.Map(func(r rune) rune {
+			if unicode.IsControl(r) {
+				return ' '
+			}
+			return r
+		}, utils.Decolorise(message))
+		if self.color != color {
+			self.fromColor = self.currentColor(now)
+			self.color = color
+			self.colorChangedAt = now
+		}
+	} else if self.Active() && self.hiddenAt.IsZero() {
+		self.hiddenAt = now
+	}
+	if !self.Active() {
+		return ToastFrame{}
+	}
+
+	opacity := 0.3 + 0.7*toastEase(now.Sub(self.shownAt))
+	if !self.hiddenAt.IsZero() {
+		if now.Sub(self.hiddenAt) >= toastFadeDuration {
+			*self = ToastAnimation{}
+			return ToastFrame{}
+		}
+		opacity *= 1 - toastEase(now.Sub(self.hiddenAt))
+	}
+	if screenWidth < 10 || screenHeight < 5 {
+		return ToastFrame{}
+	}
+
+	// Retain the width through completion to avoid a distracting resize.
+	self.width = max(self.width, min(72, max(30, utils.StringWidth(self.message)+4)))
+	width := min(self.width, screenWidth-4)
+	text := utils.TruncateWithEllipsis(self.message, width-4)
+	text += strings.Repeat(" ", width-4-utils.StringWidth(text))
+	border := strings.Repeat("─", width-2)
+	color = self.currentColor(now)
+	base := gocui.GetRGBColor(0x202528)
+	return ToastFrame{
+		Visible:    true,
+		X:          (screenWidth - width) / 2,
+		Width:      width,
+		Content:    "╭" + border + "╮\n│ " + text + " │\n╰" + border + "╯",
+		Foreground: toastBlend(base, color, opacity),
+		Background: toastBlend(base, color, 0.1*opacity),
+	}
+}
+
+func (self *ToastAnimation) currentColor(now time.Time) gocui.Attribute {
+	return toastBlend(self.fromColor, self.color, toastEase(now.Sub(self.colorChangedAt)))
+}
+
+func toastEase(elapsed time.Duration) float64 {
+	t := min(1.0, max(0.0, float64(elapsed)/float64(toastFadeDuration)))
+	return 1 - (1-t)*(1-t)*(1-t)
+}
+
+func toastBlend(from, to gocui.Attribute, amount float64) gocui.Attribute {
+	fr, fg, fb := from.RGB()
+	tr, tg, tb := to.RGB()
+	mix := func(a, b int32) int32 { return a + int32(float64(b-a)*amount) }
+	return gocui.NewRGBColor(mix(fr, tr), mix(fg, tg), mix(fb, tb))
+}
