+}
+
+func (self *ListController) wrappingChange(change int) int {
+	list := self.context.GetList()
+	length := list.Len()
+	if length == 0 || list.IsSelectingRange() {
+		return change
+	}
+	selected := list.GetSelectedLineIdx()
+	return (selected+change+length)%length - selected
 }
 
