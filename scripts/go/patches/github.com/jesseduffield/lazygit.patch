+func (self *FilesController) mainViewIsFocused() bool {
+	current := self.c.Context().CurrentStatic().GetKey()
+	return current == self.c.Contexts().Normal.GetKey() || current == self.c.Contexts().NormalSecondary.GetKey()
+}
+
+func statusFilterHidesDiffPane(c *ControllerCommon, source types.Context) bool {
+	if source.GetKey() != c.Contexts().Files.GetKey() {
+		return false
+	}
+	filter := c.Contexts().Files.GetStatusFilter()
+	return filter == filetree.DisplayStaged || filter == filetree.DisplayUnstaged
+}
