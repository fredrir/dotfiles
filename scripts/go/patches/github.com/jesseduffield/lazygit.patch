+package status
+
+import (
+	"errors"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/jesseduffield/lazygit/pkg/config"
+	"github.com/jesseduffield/lazygit/pkg/gocui"
+	"github.com/jesseduffield/lazygit/pkg/gui/types"
+	"github.com/jesseduffield/lazygit/pkg/utils"
+)
+
+func TestToastOperationLifecycle(t *testing.T) {
+	manager := NewStatusManager()
+	userConfig := &config.UserConfig{}
+	userConfig.Gui.Spinner = config.SpinnerConfig{Rate: 80, Frames: []string{"⠋", "⠙"}}
+	renders := 0
+	err := manager.WithWaitingStatus("Pushing", func() { renders++ }, func(handle *WaitingStatusHandle) error {
+		message, _ := manager.GetStatusString(userConfig)
+		if !strings.Contains(message, "Pushing") || renders != 1 {
+			t.Fatalf("progress must be present before the command starts: %q, renders=%d", message, renders)
+		}
+		handle.Hide()
+		if manager.HasStatus() {
+			t.Fatal("credential prompt must pause progress")
+		}
+		handle.Show()
+		manager.AddToastStatus("Pushed!", types.ToastKindSuccess)
+		return nil
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	message, color := manager.GetStatusString(userConfig)
+	if message != "✓  Pushed!" || color != gocui.GetRGBColor(0x73c991) {
+		t.Fatalf("completion should survive waiting handle cleanup and be green: %q %v", message, color)
+	}
+
+	failed := NewStatusManager()
+	failure := errors.New("push rejected")
+	if err := failed.WithWaitingStatus("Pushing", func() {}, func(*WaitingStatusHandle) error { return failure }); !errors.Is(err, failure) {
+		t.Fatalf("lost push failure: %v", err)
+	}
+	if failed.HasStatus() {
+		t.Fatal("failed push left a progress or success toast")
+	}
+}
+
+func TestToastProgressMorphAndDismiss(t *testing.T) {
+	var animation ToastAnimation
+	now := time.Now()
+	blue, green := gocui.GetRGBColor(0x79b8ff), gocui.GetRGBColor(0x73c991)
+	first := animation.Frame(now, "⠋  Pushing", blue, 100, 30)
+	if !first.Visible {
+		t.Fatal("first frame must be visible immediately")
+	}
+	steady := animation.Frame(now.Add(time.Second), "⠙  Pushing", blue, 100, 30)
+	if first.Foreground == steady.Foreground {
+		t.Fatal("entrance did not fade in")
+	}
+	transition := animation.Frame(now.Add(time.Second), "✓  Pushed!", green, 100, 30)
+	if transition.Foreground != steady.Foreground || transition.X != steady.X || transition.Width != steady.Width {
+		t.Fatal("completion restarted the entrance or jumped in size/color")
+	}
+	success := animation.Frame(now.Add(2*time.Second), "✓  Pushed!", green, 100, 30)
+	if success.Foreground != green {
+		t.Fatalf("success did not turn green: %v", success.Foreground)
+	}
+	exit := animation.Frame(now.Add(3*time.Second), "", 0, 100, 30)
+	if !exit.Visible || !strings.Contains(exit.Content, "Pushed!") {
+		t.Fatal("exit discarded content before fading")
+	}
+	fading := animation.Frame(now.Add(3*time.Second+75*time.Millisecond), "", 0, 100, 30)
+	if !fading.Visible || fading.Foreground == success.Foreground {
+		t.Fatal("exit did not fade")
+	}
+	gone := animation.Frame(now.Add(4*time.Second), "", 0, 100, 30)
+	if gone.Visible || animation.Active() {
+		t.Fatal("toast did not finish dismissing")
+	}
+}
+
+func TestToastResizeUnicodeAndReplacement(t *testing.T) {
+	var animation ToastAnimation
+	now := time.Now()
+	color := gocui.GetRGBColor(0x79b8ff)
+	for _, width := range []int{100, 40, 16, 10, 120} {
+		frame := animation.Frame(now, "⠋  推送中 "+strings.Repeat("🚀", 50)+"\nnext line", color, width, 30)
+		if !frame.Visible || frame.X < 0 || frame.X+frame.Width > width || abs(frame.X-(width-frame.X-frame.Width)) > 1 {
+			t.Fatalf("toast is not centered within %d columns: %+v", width, frame)
+		}
+		lines := strings.Split(frame.Content, "\n")
+		if len(lines) != 3 {
+			t.Fatalf("message broke the toast: %q", frame.Content)
+		}
+		for _, line := range lines {
+			if utils.StringWidth(line) != frame.Width {
+				t.Fatalf("clipped Unicode frame: %q", line)
+			}
+		}
+	}
+	if animation.Frame(now, "Pushing", color, 8, 3).Visible {
+		t.Fatal("toast overflows tiny terminal")
+	}
+	animation.Frame(now.Add(time.Second), "", 0, 100, 30)
+	if !animation.Frame(now.Add(time.Second+50*time.Millisecond), "Fetching", color, 100, 30).Visible {
+		t.Fatal("replacement during fade-out disappeared")
+	}
+}
+
+func TestToastDoesNotResurfaceStaleSuccess(t *testing.T) {
+	manager := NewStatusManager()
+	manager.AddToastStatus("Previous push", types.ToastKindSuccess)
+	id := manager.addStatus("Pushing", "waiting", types.ToastKindStatus)
+	manager.removeStatus(id)
+	if manager.HasStatus() {
+		t.Fatal("previous success resurfaced after a later push failed")
+	}
+}
+
+func TestToastRenderLoopHandoff(t *testing.T) {
+	manager := NewStatusManager()
+	if !manager.ClaimRenderLoop() || manager.ClaimRenderLoop() {
+		t.Fatal("duplicate render loop")
+	}
+	id := manager.addStatus("Pushing", "waiting", types.ToastKindStatus)
+	if manager.ReleaseRenderLoopIfEmpty() {
+		t.Fatal("released an active loop")
+	}
+	manager.removeStatus(id)
+	if !manager.ReleaseRenderLoopIfEmpty() || !manager.ClaimRenderLoop() {
+		t.Fatal("could not restart after dismissal")
+	}
+}
+
+func abs(n int) int {
+	if n < 0 {
+		return -n
+	}
+	return n
+}
