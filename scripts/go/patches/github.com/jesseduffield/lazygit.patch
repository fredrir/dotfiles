+	message, color := self.statusMgr().GetStatusString(self.c.UserConfig())
+	frame := self.toast.Frame(time.Now(), message, color, width, height)
+	changed := view.Visible != frame.Visible
+	view.Visible = frame.Visible
+	if !frame.Visible {
+		return changed, nil
+	}
+	x0, y0, x1, y1 := view.Dimensions()
+	changed = changed || x0 != frame.X-1 || y0 != 0 || x1 != frame.X+frame.Width || y1 != 4
+	if _, err := g.SetView(view.Name(), frame.X-1, 0, frame.X+frame.Width, 4, 0); err != nil {
+		return changed, err
+	}
+	if changed || frame != self.toastFrame {
+		view.FgColor, view.BgColor = frame.Foreground, frame.Background
+		self.c.SetViewContent(view, frame.Content)
+		self.toastFrame = frame
+	}
+	return changed, nil
