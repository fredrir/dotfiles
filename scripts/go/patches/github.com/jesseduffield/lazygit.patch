+package gui
+
+import (
+	"time"
+
+	"github.com/jesseduffield/lazycore/pkg/boxlayout"
+	"github.com/jesseduffield/lazygit/pkg/config"
+	"github.com/jesseduffield/lazygit/pkg/gocui"
+	"github.com/jesseduffield/lazygit/pkg/gui/controllers/helpers"
+	"github.com/jesseduffield/lazygit/pkg/gui/types"
+	"github.com/samber/lo"
+)
+
+// A panelBorder is where windows meet and can be resized by dragging.
+type panelBorder struct {
+	name          string
+	before, after []string
+	// The border runs top to bottom, so dragging moves it along x
+	vertical bool
+	// Last column or row of the windows before the border
+	position int
+	resize   func(position int)
+	reset    func()
+}
+
+type borderDrag struct {
+	dragging    string
+	grabOffset  int
+	lastPressed string
+	lastPress   time.Time
+}
+
+func (gui *Gui) interceptPanelBorderMouse(ev gocui.MouseEvent) (bool, error) {
+	drag := &gui.borderDrag
+	if drag.dragging != "" {
+		if ev.Key == gocui.MouseLeft && ev.Mod == gocui.ModMotion {
+			if border, ok := gui.panelBorderNamed(drag.dragging); ok {
+				border.resize(border.coordinate(ev.X, ev.Y) - drag.grabOffset)
+				gui.highlightPanelBorder(&border, ev.X, ev.Y)
+			}
+			return true, nil
+		}
+		drag.dragging = ""
+		gui.c.SaveAppStateAndLogError()
+		if ev.Key == gocui.MouseRelease {
+			gui.highlightPanelBorder(gui.panelBorderAt(ev.X, ev.Y), ev.X, ev.Y)
+			return true, nil
+		}
+	}
+
+	border := gui.panelBorderAt(ev.X, ev.Y)
+	if ev.Hover {
+		gui.highlightPanelBorder(border, ev.X, ev.Y)
+		return false, nil
+	}
+	if border == nil || ev.Key != gocui.MouseLeft || ev.Mod != gocui.ModNone {
+		return false, nil
+	}
+
+	if drag.lastPressed == border.name && time.Since(drag.lastPress) < gocui.DOUBLE_CLICK_THRESHOLD {
+		border.reset()
+		drag.lastPressed = ""
+	} else {
+		drag.lastPressed, drag.lastPress = border.name, time.Now()
+	}
+	drag.dragging, drag.grabOffset = border.name, border.coordinate(ev.X, ev.Y)-border.position
+	gui.highlightPanelBorder(border, ev.X, ev.Y)
+	return true, nil
+}
+
+func (gui *Gui) panelBorderAt(x int, y int) *panelBorder {
+	if gui.helpers.Confirmation.IsPopupPanelFocused() {
+		return nil
+	}
+	view, err := gui.g.VisibleViewByPosition(x, y)
+	if err != nil {
+		return nil
+	}
+	context, ok := gui.helpers.View.ContextForView(view.Name())
+	if !ok {
+		return nil
+	}
+	window := context.GetWindowName()
+	for _, border := range gui.panelBorders() {
+		coordinate := border.coordinate(x, y)
+		if coordinate == border.position && lo.Contains(border.before, window) {
+			return &border
+		}
+		if coordinate == border.position+1 && lo.Contains(border.after, window) && !isOnTab(view, border, x) {
+			return &border
+		}
+	}
+	return nil
+}
+
+// Tabs in the title row stay clickable.
+func isOnTab(view *gocui.View, border panelBorder, x int) bool {
+	x0, _, _, _ := view.Dimensions()
+	return !border.vertical && len(view.Tabs) > 1 && view.GetClickedTabIndex(x-x0) >= 0
+}
+
+func (gui *Gui) panelBorderNamed(name string) (panelBorder, bool) {
+	return lo.Find(gui.panelBorders(), func(border panelBorder) bool { return border.name == name })
+}
+
+func (gui *Gui) panelBorders() []panelBorder {
+	dims := gui.PrevLayout.WindowDimensions
+	sizes := &gui.c.GetAppState().PanelSizes
+	isShown := func(window string, _ int) bool {
+		d, ok := dims[window]
+		return ok && d.X1 >= d.X0 && d.Y1 >= d.Y0
+	}
+	sideWindows := lo.Filter(gui.helpers.Window.SideWindows(), isShown)
+	mainWindows := lo.Filter([]string{"main", "secondary", "extras"}, isShown)
+	borders := []panelBorder{}
+
+	if gui.State.ScreenMode == types.SCREEN_NORMAL && len(sideWindows) > 0 && len(mainWindows) > 0 {
+		last := dims[sideWindows[len(sideWindows)-1]]
+		vertical := last.X1 < dims[mainWindows[0]].X0
+		_, position := span(last, vertical)
+		before := lo.Filter(sideWindows, func(window string, _ int) bool { _, end := span(dims[window], vertical); return end == position })
+		after := lo.Filter(mainWindows, func(window string, _ int) bool { start, _ := span(dims[window], vertical); return start == position+1 })
+		if len(after) > 0 {
+			start, _ := span(dims[sideWindows[0]], vertical)
+			_, end := span(dims[mainWindows[len(mainWindows)-1]], vertical)
+			borders = append(borders, shareBorder(before, after, vertical, position, start, end, &sizes.SidePanelWidth))
+		}
+	}
+
+	if len(sideWindows) > 1 {
+		top, bottom := dims[sideWindows[0]].Y0, dims[sideWindows[len(sideWindows)-1]].Y1
+		if helpers.SidePanelsAreWeighted(gui.State.ScreenMode, len(sideWindows), bottom-top+1) {
+			for i := range len(sideWindows) - 1 {
+				borders = append(borders, sidePanelBorder(dims, sideWindows, i, sizes))
+			}
+		}
+	}
+
+	if isShown("main", 0) && isShown("secondary", 0) {
+		main, secondary := dims["main"], dims["secondary"]
+		vertical := main.X1 < secondary.X0
+		start, position := span(main, vertical)
+		_, end := span(secondary, vertical)
+		borders = append(borders, shareBorder([]string{"main"}, []string{"secondary"}, vertical, position, start, end, &sizes.MainPanelSplit))
+	}
+
+	return borders
+}
+
+// shareBorder splits start..end, storing the share before the border.
+func shareBorder(before []string, after []string, vertical bool, position int, start int, end int, share *float64) panelBorder {
+	length := end - start + 1
+	return panelBorder{
+		name:     before[0] + "|" + after[0],
+		before:   before,
+		after:    after,
+		vertical: vertical,
+		position: position,
+		resize: func(position int) {
+			size := lo.Clamp(position-start+1, helpers.MinPanelSize, length-helpers.MinPanelSize)
+			*share = float64(size) / float64(length)
+		},
+		reset: func() { *share = 0 },
+	}
+}
+
+func sidePanelBorder(dims map[string]boxlayout.Dimensions, windows []string, index int, sizes *config.PanelSizes) panelBorder {
+	upper, lower := windows[index], windows[index+1]
+	return panelBorder{
+		name:     upper + "|" + lower,
+		before:   []string{upper},
+		after:    []string{lower},
+		position: dims[upper].Y1,
+		resize: func(position int) {
+			heights := lo.Assign(sizes.SidePanelHeights, lo.SliceToMap(windows, func(window string) (string, int) {
+				return window, dims[window].Y1 - dims[window].Y0 + 1
+			}))
+			pair := heights[upper] + heights[lower]
+			heights[upper] = lo.Clamp(position-dims[upper].Y0+1, helpers.MinPanelSize, pair-helpers.MinPanelSize)
+			heights[lower] = pair - heights[upper]
+			sizes.SidePanelHeights = heights
+		},
+		reset: func() { sizes.SidePanelHeights = nil },
+	}
+}
+
+func (border panelBorder) coordinate(x int, y int) int {
+	return lo.Ternary(border.vertical, x, y)
+}
+
+func span(d boxlayout.Dimensions, vertical bool) (int, int) {
+	if vertical {
+		return d.X0, d.X1
+	}
+	return d.Y0, d.Y1
+}
+
+// highlightPanelBorder colors the border and centers handles on it where the pointer crosses it.
+func (gui *Gui) highlightPanelBorder(border *panelBorder, x int, y int) {
+	edges := map[string]byte{}
+	handles := map[string]gocui.FrameHandle{}
+	if border != nil {
+		sides := []struct {
+			windows []string
+			edge    byte
+			handle  []rune
+		}{
+			{border.before, gocui.BOTTOM, []rune("━━▲━━")},
+			{border.after, gocui.TOP, []rune("━━▼━━")},
+		}
+		if border.vertical {
+			sides[0].edge, sides[0].handle = gocui.RIGHT, []rune("┃◀┃")
+			sides[1].edge, sides[1].handle = gocui.LEFT, []rune("┃▶┃")
+		}
+		across := lo.Ternary(border.vertical, y, x)
+		for _, side := range sides {
+			for _, window := range side.windows {
+				edges[window] = side.edge
+				// Every view clips the handle to itself, so it can run across windows.
+				handles[window] = gocui.FrameHandle{Edge: side.edge, Start: across - len(side.handle)/2, Runes: side.handle}
+			}
+		}
+	}
+	for _, context := range gui.State.Contexts.Flatten() {
+		if view := context.GetView(); view != nil {
+			view.HighlightedEdges = edges[context.GetWindowName()]
+			view.FrameHandle = handles[context.GetWindowName()]
+		}
+	}
+}
