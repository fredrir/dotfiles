#!/bin/sh
# Resolve one mDNS peer but only accept a path whose peer and chosen source
# are both on the home subnet. This is used as an OpenSSH ProxyCommand so a
# LAN-labelled route cannot quietly traverse archie-direct or Tailscale.
# --refresh stores the pair; other modes reuse it while fresh instead of mDNS.

set -eu

PROGRAM=home-lan-connect
HOME_PREFIX=192.168.50.
STATE_DIR=${HOME_LAN_CONNECT_STATE:-${XDG_STATE_HOME:-$HOME/.local/state}/home-lan-connect}
FRESH_MINUTES=1

fail() {
	printf '%s: %s\n' "$PROGRAM" "$*" >&2
	exit 1
}

resolve_peer() {
	name=$1
	case $(uname -s) in
	Darwin)
		dscacheutil -q host -a name "$name" 2>/dev/null |
			sed -n 's/^ip_address: //p'
		;;
	Linux)
		avahi-resolve-host-name -4 "$name" 2>/dev/null |
			awk '{ print $2 }'
		;;
	*) fail "unsupported operating system" ;;
	esac | awk -v prefix="$HOME_PREFIX" 'index($0, prefix) == 1 { print; exit }'
}

source_for() {
	peer=$1
	case $(uname -s) in
	Darwin)
		interface=$(route -n get "$peer" 2>/dev/null | awk '$1 == "interface:" { print $2; exit }')
		[ -n "$interface" ] || return 1
		ipconfig getifaddr "$interface" 2>/dev/null
		;;
	Linux)
		ip -4 route get "$peer" 2>/dev/null |
			awk '{ for (i = 1; i <= NF; i++) if ($i == "src") { print $(i + 1); exit } }'
		;;
	esac
}

resolve_pair() {
	peer=$(resolve_peer "$1")
	[ -n "$peer" ] || fail "$1 has no IPv4 address in ${HOME_PREFIX}0/24"
	source=$(source_for "$peer")
	case "$source" in
	"$HOME_PREFIX"*) ;;
	*) fail "route to $peer selects non-LAN source ${source:-none}" ;;
	esac
	printf '%s %s\n' "$source" "$peer"
}

cached_pair() {
	file=$STATE_DIR/$1
	[ -n "$(find "$file" -mmin -"$FRESH_MINUTES" 2>/dev/null)" ] || return 1
	cat "$file"
}

store_pair() {
	mkdir -p "$STATE_DIR"
	staged=$(mktemp "$STATE_DIR/.$1.XXXXXX")
	printf '%s' "$2" >"$staged"
	mv -f "$staged" "$STATE_DIR/$1"
}

mode=connect
case ${1:-} in
--probe | --resolve | --refresh)
	mode=${1#--}
	shift
	;;
esac
[ "$#" -ge 1 ] || fail "usage: $PROGRAM [--resolve | --probe | --refresh] host [port]"
host=$1
port=${2:-22}
case $host in
'' | .* | */*) fail "invalid host: $host" ;;
esac

if [ "$mode" = refresh ]; then
	pair=$(resolve_pair "$host") || pair=
	store_pair "$host" "$pair"
	[ -n "$pair" ] || exit 1
	printf '%s\n' "$pair"
	exit 0
fi

if pair=$(cached_pair "$host"); then
	[ -n "$pair" ] || fail "$host is not on ${HOME_PREFIX}0/24"
else
	pair=$(resolve_pair "$host") || exit 1
fi
source=${pair% *}
peer=${pair#* }

[ "$mode" = resolve ] && {
	printf '%s %s\n' "$source" "$peer"
	exit 0
}

if [ "$mode" = probe ]; then
	case $(uname -s) in
	Darwin) exec nc -4 -z -G 1 -s "$source" "$peer" "$port" ;;
	*) exec nc -4 -z -w 1 -s "$source" "$peer" "$port" ;;
	esac
fi

# nc leaves Nagle on: a write spanning two segments waits ~40 ms for the peer's delayed ACK
exec socat STDIO "TCP4:$peer:$port,bind=$source,nodelay"
