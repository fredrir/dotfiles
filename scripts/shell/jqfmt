#!/bin/zsh

config="${DOTFILES}/tools/jqfmt.dotfile"

indent=2
align=false
align_max=24
blank_lines=0
final_newline=true

if [[ -f "$config" ]]; then
	while IFS= read -r line; do
		# Remove comments.
		line="${line%%#*}"

		# Ignore braces/empty lines.
		[[ "$line" == *"="* ]] || continue
		key="${line%%=*}"
		value="${line#*=}"

		# Trim whitespace.
		key="${key//[[:space:]]/}"
		value="${value//[[:space:]]/}"

		case "$key" in
		indent)
			indent="$value"
			;;
		align)
			align="$value"
			;;
		align_max)
			align_max="$value"
			;;
		blank_lines)
			blank_lines="$value"
			;;
		final_newline)
			final_newline="$value"
			;;
		esac
	done <"$config"
fi

opts=(
	--monochrome-output
	--indent "$indent"
)

if [[ "$align" == true ]]; then
	print -u2 "jqfmt: warning: jq does not support align"
fi

if ((align_max != 24)); then
	print -u2 "jqfmt: warning: jq does not support align_max"
fi

if ((blank_lines != 0)); then
	print -u2 "jqfmt: warning: jq does not support blank_lines"
fi

zmodload -F zsh/stat b:zstat
setopt extendedglob

# Hidden entries never glob, and these are the skips the dotfiles walk uses.
skip=(node_modules target dist build out venv vendor __pycache__)
skip_pattern="*/(${(j:|:)skip})/*"

failures=0

fail() {
	print -u2 "jqfmt: $1"
	failures=$((failures + 1))
}

# jq over every path in $@, or over stdin when there is none.
render() {
	if [[ "$final_newline" == false ]]; then
		setopt pipefail
		jq "${opts[@]}" '.' "$@" | perl -pe 'chomp if eof'
	else
		jq "${opts[@]}" '.' "$@"
	fi
}

# jq leaves the file out of parse errors, so the caller names it.
in_place() {
	local file=$1
	local real=${file:A}
	local temporary="${real:h}/.${real:t}.jqfmt-$$-$RANDOM"
	local errors="$temporary.error"
	local message

	if ! render "$real" 2>"$errors" >"$temporary"; then
		[[ -s "$errors" ]] && message=$(<"$errors")
		rm -f "$temporary" "$errors"
		# jq signs its diagnostics, which the caller has already named.
		message=${message#jq: }
		message=${message#error: }
		fail "$file: ${message:-could not be formatted}"
		return 1
	fi
	rm -f "$errors"

	if cmp -s "$temporary" "$real"; then
		rm -f "$temporary"
		return 0
	fi

	# A rename swaps the inode, so the mode has to travel with the contents.
	local -a stats
	if zstat -A stats +mode "$real"; then
		chmod "$(printf '%o' $((stats[1] & 8#7777)))" "$temporary"
	fi

	mv -f "$temporary" "$real" || {
		rm -f "$temporary"
		fail "$file: could not be replaced"
	}
}

targets=()
while (($#)); do
	case "$1" in
	--)
		shift
		targets+=("$@")
		break
		;;
	-)
		targets+=(-)
		;;
	-*)
		print -u2 "jqfmt: unknown option: $1"
		print -u2 "jqfmt: usage: jqfmt [--] [file | directory | -]..."
		exit 2
		;;
	*)
		targets+=("$1")
		;;
	esac
	shift
done

for target in "${targets[@]}"; do
	if [[ "$target" == - ]]; then
		render || failures=$((failures + 1))
	elif [[ -d "$target" ]]; then
		for file in "$target"/**/(#i)*.json(N); do
			# Skips apply inside the target, not to the target's own name.
			beneath=${file#$target}
			[[ "/$beneath" == ${~skip_pattern} ]] && continue
			in_place "$file"
		done
	else
		in_place "$target"
	fi
done

((failures)) && exit 1
exit 0
