    {
      "name": "apply",
      "order": 12,
      "version_owner": "builtins",
      "codes": [
        "apply/approval",
        "apply/race",
        "apply/rollback"
      ]
    }
  ],
  "details": [
    {
      "code": "discovery/inventory",
      "detail": "package_without_metadata",
      "severity": "Warning",
      "summary": "package directory without package.dotfile"
    },
    {
      "code": "resolve/identity",
      "detail": "near_entity_name",
      "severity": "Warning",
      "summary": "near-name possible entity typo"
    },
    {
      "code": "resolve/identity",
      "detail": "unused_entity_facts",
      "severity": "Warning",
      "summary": "entity facts unused by every declared profile"
    },
    {
      "code": "discovery/inventory",
      "detail": "empty_deployable_facet",
      "severity": "Warning",
      "summary": "empty deployable facet after exclusions"
    },
    {
      "code": "schema/binding",
      "detail": "unused_binding",
      "severity": "Warning",
      "summary": "unused binding"
    },
    {
      "code": "lock/stale",
      "detail": "departed_identity",
      "severity": "Warning",
      "summary": "departed node or facet compared with the previous lock"
    },
    {
      "code": "parse/syntax",
      "detail": "resource_limit",
      "severity": "Error",
      "summary": "configured parser work or depth limit was reached"
    },
    {
      "code": "schema/context",
      "detail": "unsupported_dotfile_version",
      "severity": "Error",
      "summary": "the authored source version is unsupported"
    },
    {
      "code": "lock/tampered",
      "detail": "unsupported_lock_version",
      "severity": "Error",
      "summary": "the generated lock version is unsupported"
    },
    {
      "code": "lock/tampered",
      "detail": "unsupported_builtins_version",
      "severity": "Error",
      "summary": "the built-ins version is unsupported"
    },
    {
      "code": "lock/tampered",
      "detail": "version_tuple_mismatch",
      "severity": "Error",
      "summary": "the source, generated lock, and built-ins versions do not form a registered tuple"
    }
