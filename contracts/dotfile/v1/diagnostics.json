      "order": 2,
      "version_owner": "source",
      "codes": [
        "parse/syntax"
      ]
    },
    {
      "name": "schema",
      "order": 3,
      "version_owner": "source",
      "codes": [
        "schema/context",
        "schema/duplicate",
        "schema/binding"
      ]
    },
    {
      "name": "theme",
      "order": 4,
      "version_owner": "source",
      "codes": [
        "theme/discovery",
        "theme/reference",
        "theme/merge",
        "theme/map",
        "theme/output"
      ]
    },
    {
      "name": "resolve",
      "order": 5,
      "version_owner": "source",
      "codes": [
        "resolve/reference",
        "resolve/identity",
        "resolve/resource-key",
        "resolve/fact-conflict",
        "resolve/adapter",
        "resolve/theme"
      ]
    },
    {
      "name": "graph",
      "order": 6,
      "version_owner": "source",
      "codes": [
        "graph/cycle"
      ]
    },
    {
      "name": "discovery",
      "order": 7,
      "version_owner": "source",
      "codes": [
        "discovery/group",
        "discovery/inventory",
        "discovery/source"
      ]
    },
    {
      "name": "deploy",
      "order": 8,
      "version_owner": "source",
      "codes": [
        "deploy/mapping",
        "deploy/permission",
        "deploy/collision",
        "deploy/variant"
      ]
    },
    {
      "name": "lock",
      "order": 9,
      "version_owner": "generated_lock",
      "codes": [
        "lock/stale",
        "lock/noncanonical",
        "lock/tampered"
      ]
    },
    {
      "name": "bind",
      "order": 10,
      "version_owner": "builtins",
      "codes": [
        "bind/profile",
        "bind/host",
        "bind/variant",
        "bind/destination"
