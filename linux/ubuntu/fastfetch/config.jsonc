{
	"$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",

	"display": {
		"constants": [
			// theme:constants
			"\u001b[1;38;2;61;174;233m", // blue #3daee9
			"\u001b[1;38;2;250;179;135m", // peach #fab387
			"\u001b[1;38;2;203;166;247m", // mauve #cba6f7
			"\u001b[1;38;2;124;255;107m", // green #7cff6b
			"\u001b[38;2;108;112;134m" // overlay #6c7086
			// theme:constants:end
		],
		"separator": "  ",
		"key": { "width": 14 },
		"color": { "separator": "#6c7086" }, // theme:separator
		"size": { "binaryPrefix": "jedec", "ndigits": 0 },
		"percent": { "type": 9, "green": 50, "yellow": 80 }
	},

	"logo": {
		"type": "file-raw",
		"source": "~/.config/fastfetch/ubuntu.txt",
		"padding": { "top": 1, "left": 3, "right": 5 }
	},

	// No DESKTOP section: the only profile that links this group is
	// ubuntu/server, where DE, WM, theme and display detect nothing and would
	// leave the heading standing on its own.
	"modules": [
		"break",

		{ "type": "title", "format": "{$1}{user-name}{$4} @ {$3}{host-name}" },
		{ "type": "custom", "format": "{$5}───────────────────────────────" },
		"break",

		{ "type": "custom", "format": "{$1}  SYSTEM" },
		{ "type": "os", "key": "{$1}󰕈  OS" },
		{ "type": "kernel", "key": "{$1}󰌽  Kernel" },
		{ "type": "uptime", "key": "{$1}󰅐  Uptime" },
		{ "type": "packages", "key": "{$1}󰏗  Packages" },
		{ "type": "shell", "key": "{$1}󰆍  Shell" },
		{ "type": "terminal", "key": "{$1}󰆌  Terminal" },
		"break",

		{ "type": "custom", "format": "{$2}  HARDWARE" },
		{ "type": "cpu", "key": "{$2}󰻠  CPU" },
		{
			"type": "memory",
			"key": "{$2}󰍛  Memory",
			"format": "{used} / {total} [{percentage}]"
		},
		{
			"type": "disk",
			"key": "{$2}󰋊  Disk",
			"folders": "/",
			"format": "{mountpoint}  {size-used} / {size-total} [{size-percentage}]"
		},
		"break",

		{ "type": "custom", "format": "{$4}  NETWORK" },
		{ "type": "locale", "key": "{$4}󰗊  Locale" },
		"break",

		{ "type": "colors", "symbol": "circle", "paddingLeft": 2 }
	]
}
