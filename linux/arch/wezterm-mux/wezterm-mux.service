# dmux managed WezTerm mux server (plan §15.1, ADR 002).
# systemd is the ONLY legitimate starter: WezTerm has no unix-socket mutual
# exclusion, so a manual wezterm-mux-server on the same socket silently
# steals it and orphans this service's panes. Never start the server by hand.
[Unit]
Description=dmux-managed WezTerm multiplexer server

[Service]
# Durable per-host enablement (ADR 012 WS-F.1; plan §21 steps 7 and 9).
# `systemctl --user set-environment`/`import-environment` are runtime-only
# and a reboot clears them.  The durable source on Linux -- and the ONE knob
# here, since dmux-mux-start.sh reads ~/.config/dmux/service.env only on
# macOS -- is:
#   ~/.config/environment.d/50-dmux.conf
#     DMUX_WEZ_FIRST=1
# The user manager reads environment.d when it starts and again on
# `systemctl --user daemon-reload` (environment.d(5),
# systemd.environment-generator(7)) and exports the result to every user
# service it spawns, this unit included, and to a graphical session started
# through it, which is where the GUI reads the flag at config evaluation.
# `systemctl --user show-environment | grep DMUX_` and `dmux doctor` show
# what the manager carries versus what the file says.  To apply an edit
# without re-login: daemon-reload, then restart this unit (kills its panes)
# and relaunch the GUI.  Write DMUX_WEZ_FIRST=0 to state legacy (ADR 010 §5:
# 0 is an explicit opt-out, unset is "no preference"); the wrapper still
# defaults an unset flag to 0 until the cutover flips the tracked default.
#
# PassEnvironment= is kept as a statement of intent only.  systemd.exec(5):
# "in case of the user service manager all environment variables are passed
# to the executed processes anyway, hence this option is without effect for
# the user service manager" -- so the variable arrives from the manager's
# block with or without this line, whether environment.d or a runtime
# import put it there.
PassEnvironment=DMUX_WEZ_FIRST
# Emergency opt-out (plan §21 step 9, ADR 010 §2), same file or a runtime
# import: DMUX_LEGACY_POLICY=1 forces dmux back to legacy tmux creation even
# while DMUX_WEZ_FIRST=1 is still set, so a canary host escapes without first
# unsetting what it set.  It reverses creation policy only -- this unit keeps
# running and its panes keep living, because §21's rollback says to leave a
# live mux server alone.  Anything this service spawns sees the same verdict
# as the user's shells.
PassEnvironment=DMUX_LEGACY_POLICY
# The wrapper resolves $XDG_RUNTIME_DIR/dmux, mints a fresh server epoch,
# and boot nonce, then execs wezterm-mux-server FOREGROUND with its early
# managed-service prebind and dmux mux config; native mux-startup code publishes
# the verified descriptor (--daemonize
# contends the shared default pid-file lock, ADR 004).
ExecStart=%h/dotfiles/shared/wezterm/mux/dmux-mux-start.sh
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target
