[include]
	path = ~/dotfiles/shared/git/.gitconfig

[credential "https://github.com"]
	helper =
	helper = !/usr/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !/usr/bin/gh auth git-credential
[gpg]
	format = ssh
[user]
	signingkey = /home/fredrir/.ssh/id_ed25519.pub
[commit]
	gpgsign = true
[tag]
	gpgSign = true
