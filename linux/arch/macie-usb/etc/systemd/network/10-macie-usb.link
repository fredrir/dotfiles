# Match the USB function, not its MAC address. The Mac hands out a fresh
# NCM address every so often, and a pinned MAC silently stops matching:
# the interface keeps its kernel name, nothing holds 10.77.77.2, and
# dnsmasq waits on an interface that never appears. Vendor, product
# string and function number do not move.
[Match]
Property=ID_USB_DRIVER=cdc_ncm ID_VENDOR_ID=05ac ID_MODEL=Mac ID_USB_INTERFACE_NUM=00

[Link]
Name=macie0
# Match the Mac's MTU on this link; a 1500-byte default caps throughput
# on the 10 Gbps link well below what the cable can carry.
MTUBytes=8178
