{
  "global": {
    "show_in_menu_bar": false
  },
  "profiles": [
    {
      "complex_modifications": {
        "rules": [
          {
            "description": "Fn+dot opens WezTerm",
            "manipulators": [
              {
                "from": {
                  "key_code": "period",
                  "modifiers": {
                    "mandatory": [
                      "fn"
                    ],
                    "optional": [
                      "caps_lock"
                    ]
                  }
                },
                "to": [
                  {
                    "software_function": {
                      "open_application": {
                        "file_path": "/Applications/WezTerm.app"
                      }
                    }
                  }
                ],
                "type": "basic"
              }
            ]
          }
        ]
      },
      "devices": [
        {
          "identifiers": {
            "is_keyboard": true
          },
          "ignore": false,
          "swap_grave_accent_and_non_us_backslash": true
        }
      ],
      "name": "Default profile",
      "selected": true,
      "virtual_hid_keyboard": {
        "keyboard_type_v2": "iso"
      }
    }
  ]
}
