#!/bin/sh
# dmux.app -- the desktop entry point for WezTerm under dmux (ADR 012 §10,
# wave 4). Spotlight, the Dock and Finder launch this bundle; it inherits the
# launchd session environment, where com.fredrir.dmux-env put DMUX_WEZ_FIRST
# (the per-host value, or the tracked default 1 since the §21 step 9 flip).
#
# Flag on (1, or unset): the maintained fork refuses a bare WezTerm start (the
# GUI must be handed the managed socket by dmux's broker), so summon the one
# resident GUI through `dmux _gui summon`, which ensures the managed service
# is ready, launches the attach-only GUI when none is live and presents the
# last Space. Flag off (the explicit opt-out 0): plain WezTerm, exactly as
# before dmux. A refusal is shown in a
# dialog instead of disappearing into a log file. No shell profile is sourced
# and only fixed paths are used; DMUX_BIN / DMUX_OPEN_BIN / DMUX_OSASCRIPT_BIN
# are test seams.
set -u
dmux_bin="${DMUX_BIN:-$HOME/.local/bin/dmux}"
open_bin="${DMUX_OPEN_BIN:-/usr/bin/open}"
osascript_bin="${DMUX_OSASCRIPT_BIN:-/usr/bin/osascript}"
wezterm_bundle='com.github.wez.wezterm'

dialog() {
  escaped=$(printf '%s' "$1" | sed 's/[\\"]/\\&/g' | tr '\n' ' ')
  "$osascript_bin" -e "display dialog \"$escaped\" with title \"dmux\" buttons {\"OK\"} default button 1 with icon caution" >/dev/null 2>&1
}

if [ "${DMUX_WEZ_FIRST:-1}" != 1 ]; then
  exec "$open_bin" -b "$wezterm_bundle"
fi

if [ ! -x "$dmux_bin" ]; then
  dialog "dmux is not installed at $dmux_bin; run 'dotfile sync'."
  exit 1
fi

output=$("$dmux_bin" _gui summon --format json 2>&1)
status=$?
if [ "$status" -ne 0 ]; then
  dialog "dmux could not summon WezTerm (exit $status): $(printf '%s' "$output" | tail -c 600)"
  exit "$status"
fi
exit 0
