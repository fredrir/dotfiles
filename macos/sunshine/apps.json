{
	"apps": [
		{
			"auto-detach": true,
			"exclude-global-prep-cmd": false,
			"exit-timeout": 5,
			"image-path": "desktop.png",
			"name": "Desktop",
			"wait-all": true
		},
		{
			"detached": ["open steam://open/bigpicture"],
			"image-path": "steam.png",
			"name": "Steam Big Picture",
			"prep-cmd": [
				{
					"do": "",
					"undo": "open steam://close/bigpicture"
				}
			]
		}
	],
	"env": {
		"PATH": "$(PATH):$(HOME)/.local/bin"
	}
}
