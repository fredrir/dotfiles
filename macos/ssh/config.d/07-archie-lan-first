Match originalhost archie exec "! /usr/bin/nc -4 -z -G 1 -s 10.77.77.1 10.77.77.2 22 >/dev/null 2>&1 && ! /usr/bin/nc -4 -z -G 1 -s 10.77.78.1 10.77.78.2 22 >/dev/null 2>&1 && ~/.ssh/bin/home-lan-connect --probe archie.local 22 >/dev/null 2>&1"
    HostName archie.local
    User fredrir
    HostKeyAlias archie
    ProxyCommand ~/.ssh/bin/home-lan-connect %h %p
    ServerAliveInterval 10
    ServerAliveCountMax 3

Match all
