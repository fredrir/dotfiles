# Prefer the cable when archie answers on it. Multiplexing comes from
# 90-defaults so every route gets it, not just this one.
#
# Bound by address rather than by interface name: macOS renumbers the
# USB-NCM interface (it was en3, it is now en4), and a stale name fails the
# probe rather than the cable, so every ssh quietly takes tailscale instead.
# 10.77.77.1 is the only address dnsmasq on archie hands out, so it names
# this link and nothing else, and it exists only while the cable does.
#
# The keepalives are deliberately tighter here than on the tailscale route:
# the cable runs at ~1.7 ms with ±0.13 ms of jitter, so ten seconds of
# silence means it is gone and the next ssh should fall through to tailscale.

Match originalhost archie exec "/usr/bin/nc -4 -z -G 1 -s 10.77.77.1 10.77.77.2 22 >/dev/null 2>&1"
    HostName 10.77.77.2
    User fredrir
    HostKeyAlias archie
    BindAddress 10.77.77.1
    ServerAliveInterval 5
    ServerAliveCountMax 2

Match all
