 "retirements": [
  {
   "id": "cli::detach_outside_tmux_refuses",
   "rationale": "Plan section 14 makes headless disconnect an idempotent success; detach is its one-release compatibility alias.",
   "replacement_tests": [
    "cli::disconnect_and_legacy_detach_outside_clients_are_idempotent"
   ]
  },
  {
   "retired": "registry::recovery::intentional_empty_requires_exact_lock_epoch_and_head_without_advancing_revision",
   "replacement": [
    "registry::recovery::the_empty_floor_is_raised_only_under_the_exact_exclusive_lock_and_published_epoch",
    "registry::recovery::intentional_empty_floor_and_generation_abort_commit_or_roll_back_together",
    "registry::recovery::final_wez_tombstone_and_empty_floor_are_one_rollback_safe_transition"
   ],
   "rationale": "The two public intentional-empty floor wrappers had no production caller and ran their own transaction, so production could never call them; the floor is now one private primitive inside the production transactions and its guards are asserted on the production abort (ADR 012 WS-E.3 row 8, commit 79eaad1).",
   "recorded": "2026-08-22"
  },
  {
   "retired": "registry::recovery::atomic_generation_abort_is_fenced_preserves_proof_rows_and_unblocks_the_next_generation",
   "replacement": [
    "registry::recovery::atomic_generation_abort_with_floor_is_fenced_preserves_proof_rows_and_unblocks_the_next_generation"
   ],
   "rationale": "Same assertions plus the intentional-empty floor, through abort_recovery_generation_and_record_current_empty; the deleted floor-less abort would let the next cold start restore the aborted manifest (WS-E.3 row 8).",
   "recorded": "2026-08-22"
  },
  {
   "retired": "registry::recovery::atomic_generation_abort_accepts_each_nonterminal_root_state_only",
   "replacement": [
    "registry::recovery::atomic_generation_abort_with_floor_accepts_each_nonterminal_root_state_only"
   ],
   "rationale": "As above (WS-E.3 row 8).",
   "recorded": "2026-08-22"
  },
  {
   "retired": "registry::recovery::unfinished_lookup_tracks_nonterminal_root_and_rows_are_path_ordered (assertion: a lookup pinned to a random epoch finds nothing)",
   "replacement": [
    "registry::recovery::unfinished_lookup_tracks_nonterminal_root_and_rows_are_path_ordered (found.server_epoch == epoch)",
    "unit::operations::tests::a_durable_old_epoch_recovery_blocks_after_restart_and_process_lock_drop"
   ],
   "rationale": "The epoch-pinned unfinished_recovery was retired; the agnostic lookup is the production one for takeover discovery (WS-E.3 row 8).",
   "recorded": "2026-08-22"
  },
  {
   "retired": "registry::recovery::stale_epoch_generation_is_visible_and_can_be_retired_under_the_current_fence (assertion: the exact-epoch abort refuses)",
   "replacement": [
    "registry::recovery::stale_epoch_generation_is_visible_and_can_be_retired_under_the_current_fence (abort_stale_recovery_generation assertions; floor untouched)"
   ],
   "rationale": "The exact-epoch abort was one of the four retired APIs (WS-E.3 row 8).",
   "recorded": "2026-08-22"
  },
