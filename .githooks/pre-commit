#!/usr/bin/env bash
set -euo pipefail

root="$(git rev-parse --show-toplevel)"
export DOTFILE_ROOT="$root"
source "$root/.githooks/_dotfile.sh"
dotfile="$(resolve_dotfile "$root" || true)"

staged() { git diff --cached --name-only -- "$@" | grep -q .; }

if [ ! -x "$dotfile" ]; then
	echo "pre-commit: error: dotfile secret scan cannot run: native dotfile missing" >&2
	echo "pre-commit: error: dotfile secret: run: ./setup.sh" >&2
	exit 1
fi

if staged config/keys.dotfile; then
	"$dotfile" secret sync >/dev/null
	if [ -e "$root/.sops.yaml" ]; then
		git add "$root/.sops.yaml"
	fi
fi

"$dotfile" secret scan --review --staged >/dev/null
