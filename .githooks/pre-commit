#!/usr/bin/env bash
set -euo pipefail

root="$(git rev-parse --show-toplevel)"
bin="$root/scripts/python/.venv/bin"
dotfile="$bin/dotfile-py"

staged() { git diff --cached --name-only -- "$@" | grep -q .; }

if [ ! -x "$dotfile" ]; then
	echo "pre-commit: error: dotfile secret scan cannot run: missing scripts/python/.venv" >&2
	echo "pre-commit: error: dotfile secret: run: ./setup.sh" >&2
	exit 1
fi

if staged config/keys.dotfile; then
	"$dotfile" secret sync >/dev/null
	if [ -e "$root/.sops.yaml" ]; then
		git add "$root/.sops.yaml"
	fi
fi

"$dotfile" secret scan --staged >/dev/null
