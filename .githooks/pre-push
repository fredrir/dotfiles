#!/usr/bin/env bash
set -euo pipefail

root="$(git rev-parse --show-toplevel)"
bin="$root/scripts/python/.venv/bin"

if [ ! -x "$bin/dotfile" ]; then
	echo "pre-push: scripts/python/.venv missing, the secret scan cannot run" >&2
	echo "pre-push: run ./setup.sh (or: uv sync --project scripts/python --locked)" >&2
	exit 1
fi

zero="$(git hash-object --stdin </dev/null | tr '[:xdigit:]' '0')"
status=0

while read -r _local_ref local_oid _remote_ref remote_oid; do
	if [ "$local_oid" = "$zero" ]; then
		continue
	fi
	if [ "$remote_oid" = "$zero" ]; then
		range="$local_oid --not --remotes"
	else
		range="$remote_oid..$local_oid"
	fi
	if ! "$bin/dotfile" secret scan --commits "$range" >/dev/null; then
		status=1
	fi
done

if [ "$status" -ne 0 ]; then
	echo "pre-push: refusing to push; the commits above still carry the finding" >&2
	echo "pre-push: rewrite them, or rotate the value and remove it from every commit" >&2
fi

exit "$status"
