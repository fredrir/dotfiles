#!/usr/bin/env bash
set -euo pipefail

root="$(git rev-parse --show-toplevel)"
export DOTFILE_ROOT="$root"
source "$root/.githooks/_dotfile.sh"
dotfile="$(resolve_dotfile "$root" || true)"

if [ ! -x "$dotfile" ]; then
	echo "pre-push: native dotfile missing, the secret scan cannot run" >&2
	echo "pre-push: run ./setup.sh" >&2
	exit 1
fi

zero="$(git hash-object --stdin </dev/null | tr '[:xdigit:]' '0')"
ranges=()

while read -r _local_ref local_oid _remote_ref remote_oid; do
	if [ "$local_oid" = "$zero" ]; then
		continue
	fi
	if [ "$remote_oid" = "$zero" ]; then
		range="$local_oid --not --remotes"
	else
		range="$remote_oid..$local_oid"
	fi
	ranges+=(--commits "$range")
done

if [ "${#ranges[@]}" -gt 0 ] && ! "$dotfile" secret scan --review "${ranges[@]}" >/dev/null; then
	echo "pre-push: aborted; unresolved findings remain in outgoing commits" >&2
	exit 1
fi
